<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CBTPRDM_TP03.Mvvm.ViewModels"
             x:Class="CBTPRDM_TP03.Mvvm.Views.MainPage"
             Title="Rastreamento Logistico"
             Shell.BackgroundColor="Honeydew"
             Shell.TitleColor="Black"
             BackgroundColor="White">
    
    <ContentPage.BindingContext>
        <viewmodels:TrackingViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Digite o código de rastreamento:"
                   TextColor="Black"
                   FontSize="16"
                   FontAttributes="Bold" />
            
            <VerticalStackLayout Spacing="8">
                <Label Text="Códigos disponíveis para teste:" 
                       FontAttributes="Bold" 
                       FontSize="14" 
                       TextColor="#3A3B3C" />
            
                <Label Text="• BR123456789 (Estado: Em Trânsito)" 
                       FontSize="13" 
                       TextColor="#808080" />
            
                <Label Text="• SP987654321 (Estado: Entregue)" 
                       FontSize="13" 
                       TextColor="#808080" />
            
                <Label Text="• EX999999999 (Estado: Aguardando Retirada)" 
                       FontSize="13" 
                       TextColor="#808080" />
            </VerticalStackLayout>

            <!-- Entrada de dados (Entry) -->
            <Entry Placeholder="Ex: BR123456789, SP987654321, EX999999999" 
                   Text="{Binding InputCode}"
                   TextColor="Black"
                   BackgroundColor="Honeydew"/>

            <!-- Botão de Pesquisa vinculado ao Command da ViewModel -->
            <Button Text="Rastrear Pacote"
                    FontAttributes="Bold"
                    Command="{Binding SearchCommand}"
                    BackgroundColor="Yellow"
                    TextColor="Black" />

            <!-- Seção de Resultados (Exibida dinamicamente se HasResult for true) -->
            <VerticalStackLayout IsVisible="{Binding HasResult}" Spacing="10" Margin="0,20,0,0">
                <BoxView HeightRequest="1" Color="Gray" />

                <Label Text="Detalhes do Pacote" FontSize="18" FontAttributes="Bold" TextColor="DarkBlue" />

                <HorizontalStackLayout Spacing="5">
                    <Label Text="Código:" TextColor="Black" FontAttributes="Bold" />
                    <Label Text="{Binding Package.TrackingCode}" TextColor="Black" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="5">
                    <Label Text="Status:" TextColor="Black" FontAttributes="Bold" />
                    <Label Text="{Binding Package.Status}" TextColor="Green" FontAttributes="Bold" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="5">
                    <Label Text="Local Atual:" TextColor="Black" FontAttributes="Bold" />
                    <Label Text="{Binding Package.CurrentLocation}" TextColor="Black" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="5">
                    <Label Text="Previsão de Entrega:" TextColor="Black" FontAttributes="Bold" />
                    <Label Text="{Binding Package.EstimatedDeliveryDate, StringFormat='{0:dd/MM/yyyy}'}" TextColor="Black" />
                </HorizontalStackLayout>

                <Label Text="Histórico de Eventos:" TextColor="Black" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0" />

                <!-- Lista (CollectionView) para exibir o histórico de eventos do pacote -->
                <CollectionView ItemsSource="{Binding Package.History}" HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BorderColor="LightGray" Padding="10" Margin="0,5">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Description}" FontAttributes="Bold" />
                                    <Label Text="{Binding Location}" FontSize="12" TextColor="Gray" />
                                    <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="10" TextColor="DarkGray" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>